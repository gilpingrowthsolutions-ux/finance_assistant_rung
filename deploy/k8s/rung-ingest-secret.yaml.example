# Example Secret for the Rung ingest CronJob.
#
# Real secrets MUST NOT be committed to source control. To use:
#   1. Copy this file to deploy/k8s/rung-ingest-secret.yaml
#   2. Replace the example values below with real ones.
#   3. Apply: kubectl apply -f deploy/k8s/rung-ingest-secret.yaml
#
# Alternatively use a secret manager (External Secrets Operator,
# Sealed Secrets, Vault Agent Injector, etc.) and have the controller
# materialise this Secret at runtime.
#
# Required keys:
#   KROGER_CLIENT_ID      -- developer.kroger.com
#   KROGER_CLIENT_SECRET  -- developer.kroger.com
#   DATABASE_URL          -- e.g. postgresql://rung:rung@rung-db:5432/rung
#                            or   sqlite:///var/lib/rung/finance.db (with PVC)
apiVersion: v1
kind: Secret
metadata:
  name: rung-ingest-secret
  labels:
    app: rung
    component: store-cache-ingest
type: Opaque
stringData:
  KROGER_CLIENT_ID: "REPLACE_WITH_KROGER_CLIENT_ID"
  KROGER_CLIENT_SECRET: "REPLACE_WITH_KROGER_CLIENT_SECRET"
  DATABASE_URL: "sqlite:////var/lib/rung/finance.db"