# Template - Safe for GitHub!
PLAID_CLIENT_ID="your_plaid_client_id_here"
PLAID_SECRET="your_plaid_secret_here"
PLAID_ENV="sandbox"
# Beta/production requires PostgreSQL. For local development only, use
# RUNG_DB_PATH=/tmp/rung-local.db or another non-production SQLite path.
DATABASE_URL="postgresql://rung:replace_me@localhost:5432/rung"
RUNG_DB_POOL_SIZE="5"
RUNG_DB_MAX_OVERFLOW="5"
RUNG_DB_POOL_TIMEOUT_SECONDS="10"
RUNG_DB_POOL_RECYCLE_SECONDS="1800"
RUNG_DB_STATEMENT_TIMEOUT_MS="30000"

# Kroger Developer API credentials for scripts/ingest_store_prices.py.
# Register at https://developer.kroger.com to get these; the free tier
# supports the product.compact scope used by the CLI ingest.
#
# These are loaded at app startup via python-dotenv (see app.py) and
# automatically picked up by services/kroger_api.py and store_api.py.
KROGER_CLIENT_ID="your_kroger_client_id_here"
KROGER_CLIENT_SECRET="your_kroger_client_secret_here"

# RapidAPI Real-Time Product Search key for services/rapidapi_search.py.
# Get your free key at https://rapidapi.com/AGHP/public/real-time-product-search/
RAPIDAPI_KEY="your_rapidapi_key_here"
